# .streamlit/secrets.toml.example
# For local testing, copy this file to .streamlit/secrets.toml
# For Streamlit Community Cloud, enter these settings under:
# App Settings -> Secrets in the Streamlit Cloud Dashboard

# Deployment Mode: "cloud" for Streamlit Community Cloud; "local" for self-hosted
DEPLOYMENT_MODE = "cloud"

# OpenAI API Key (required for generation and embeddings in Cloud mode)
OPENAI_API_KEY = "sk-proj-yourOpenAiApiKeyHere"

# Resource & Protection Limits (defaults shown)
# MAX_FILE_SIZE_MB = 15
# MAX_PDF_PAGES = 60
# MAX_DOCS_PER_SESSION = 5
